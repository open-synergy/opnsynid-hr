<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Employee View -->
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.personal.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_of_birth']" position="after">
                <field name="birth_state_id" />
                <field name="ethnicity_id" />
                <field name="religion_id" />
                <field name="blood_type" />
                <field name="blood_type_rhesus" />
            </xpath>
            <xpath expr="//page[@name='personal_information']" position="inside">
                <div name="children_button_box">
                    <button
                        name="action_add_child"
                        type="object"
                        string="Add Child"
                        class="oe_highlight"
                        attrs="{'invisible': [('address_home_id', '=', False)]}"
                    />
                </div>
                <separator string="Children" />
                <field name="children_ids" nolabel="1">
                    <tree>
                        <field name="name" />
                        <field name="birth_city" />
                        <field name="birthdate_date" />
                        <field name="gender" />
                    </tree>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
